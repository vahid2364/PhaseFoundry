\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Components of the first gauge-invariant eigenvector of the chemical Hessian as a function of temperature for BCC \ch {Hf_{0.6}Nb_{0.1}Ti_{0.1}V_{0.2}}. The dominant instability mode corresponds to Hf-enrichment at the expense of V; the large Hf--V atomic radius mismatch causes coherent strain to stabilize this mode at all temperatures shown, reversing the sign of the first eigenvalue from negative (chemical) to positive (coherent).}}{20}{figure.caption.78}\protected@file@percent }
\newlabel{fig:eigenvector}{{4}{20}{Components of the first gauge-invariant eigenvector of the chemical Hessian as a function of temperature for BCC \ch {Hf_{0.6}Nb_{0.1}Ti_{0.1}V_{0.2}}. The dominant instability mode corresponds to Hf-enrichment at the expense of V; the large Hf--V atomic radius mismatch causes coherent strain to stabilize this mode at all temperatures shown, reversing the sign of the first eigenvalue from negative (chemical) to positive (coherent)}{figure.caption.78}{}}
\newlabel{fig:eigenvector@cref}{{[figure][4][]4}{[1][18][]20}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Gauge-invariant first eigenvalue of the chemical and coherent Gibbs energy Hessian as a function of temperature for BCC (a)~\ch {Hf_{0.10}Nb_{0.40}Ti_{0.40}V_{0.10}}, (b)~\ch {Hf_{0.25}Nb_{0.25}Ti_{0.25}V_{0.25}}, and (c)~\ch {Hf_{0.6}Nb_{0.1}Ti_{0.1}V_{0.2}}. Coherency shifts the spinodal temperature downward most strongly in Hf-rich alloys. The equiatomic composition (b) is coherently spinodal below ${\sim }\SI {800}{\kelvin }$, confirming \SI {500}{\celsius  } as a tractable simulation temperature.}}{21}{figure.caption.79}\protected@file@percent }
