\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Microstructure comparison of the \texttt  {fd} and \texttt  {jansson} derivative modes for the Nb-V BCC\textsubscript  {A2} binary at $T = \SI {500}{\celsius  }$ after $80\,000$ time steps ($t = \SI {800}{\second }$, $256 \times 256$ grid, $L = \SI {1}{\micro  \metre }$, initial composition $c_0 = x_{\rm  V} = 0.50$). (a)~Finite-difference and (b)~Jansson direct composition fields $x_{\rm  V}$; fully coarsened V-rich (red) and Nb-rich (blue) spinodal domains are visible. (c)~Absolute difference map $|x^{\rm  fd}_{\rm  V} - x^{\rm  jansson}_{\rm  V}|$, showing that discrepancies are confined to interfaces ($\mathrm  {RMSE} = \num {1.31e-5}$, max $= \num {2.42e-4}$). The table summarises composition statistics and simulation wall times for each derivative method (FD: \SI {279}{\second }; Jansson: \SI {199}{\second }). }}{14}{figure.caption.63}\protected@file@percent }
\newlabel{fig:microstructure_methods}{{2}{14}{Microstructure comparison of the \texttt {fd} and \texttt {jansson} derivative modes for the Nb-V BCC\textsubscript {A2} binary at $T = \SI {500}{\celsius }$ after $80\,000$ time steps ($t = \SI {800}{\second }$, $256 \times 256$ grid, $L = \SI {1}{\micro \metre }$, initial composition $c_0 = x_{\rm V} = 0.50$). (a)~Finite-difference and (b)~Jansson direct composition fields $x_{\rm V}$; fully coarsened V-rich (red) and Nb-rich (blue) spinodal domains are visible. (c)~Absolute difference map $|x^{\rm fd}_{\rm V} - x^{\rm jansson}_{\rm V}|$, showing that discrepancies are confined to interfaces ($\mathrm {RMSE} = \num {1.31e-5}$, max $= \num {2.42e-4}$). The table summarises composition statistics and simulation wall times for each derivative method (FD: \SI {279}{\second }; Jansson: \SI {199}{\second })}{figure.caption.63}{}}
