\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Derivative-method comparison (\texttt  {fd} vs.\ \texttt  {jansson}) for Nb-V BCC\textsubscript  {A2} at $T = \SI {500}{\celsius  }$ ($c_0 = x_{\rm  V} = 0.50$, $L = \SI {1}{\micro  \metre }$). \textit  {Top row} (2D, $256\times 256$ grid, $t = \SI {800}{\second }$, 80\,000 steps): (a)~finite-difference and (b)~Jansson direct composition fields $x_{\rm  V}$; (c)~absolute difference map $|x^{\rm  fd}_{\rm  V} - x^{\rm  jansson}_{\rm  V}|$ ($\mathrm  {RMSE} = \num {1.31e-5}$, max $= \num {2.42e-4}$); table: composition statistics and wall times (FD: \SI {279}{\second }; Jansson: \SI {199}{\second }). \textit  {Bottom row} (3D, $64^3$ grid, $t = \SI {800}{\second }$, 5\,000 steps, $z = L/2$ mid-plane slice): (a)~finite-difference, (b)~Jansson, (c)~absolute difference; discrepancies remain confined to domain interfaces in both 2D and 3D, confirming method equivalence independent of dimensionality. }}{16}{figure.caption.69}\protected@file@percent }
\newlabel{fig:microstructure_methods}{{2}{16}{Derivative-method comparison (\texttt {fd} vs.\ \texttt {jansson}) for Nb-V BCC\textsubscript {A2} at $T = \SI {500}{\celsius }$ ($c_0 = x_{\rm V} = 0.50$, $L = \SI {1}{\micro \metre }$). \textit {Top row} (2D, $256\times 256$ grid, $t = \SI {800}{\second }$, 80\,000 steps): (a)~finite-difference and (b)~Jansson direct composition fields $x_{\rm V}$; (c)~absolute difference map $|x^{\rm fd}_{\rm V} - x^{\rm jansson}_{\rm V}|$ ($\mathrm {RMSE} = \num {1.31e-5}$, max $= \num {2.42e-4}$); table: composition statistics and wall times (FD: \SI {279}{\second }; Jansson: \SI {199}{\second }). \textit {Bottom row} (3D, $64^3$ grid, $t = \SI {800}{\second }$, 5\,000 steps, $z = L/2$ mid-plane slice): (a)~finite-difference, (b)~Jansson, (c)~absolute difference; discrepancies remain confined to domain interfaces in both 2D and 3D, confirming method equivalence independent of dimensionality}{figure.caption.69}{}}
\newlabel{fig:microstructure_methods@cref}{{[figure][2][]2}{[1][15][]16}{}{}{}}
\newlabel{fig:microstructure_methods_3d}{{2}{16}{Derivative-method comparison (\texttt {fd} vs.\ \texttt {jansson}) for Nb-V BCC\textsubscript {A2} at $T = \SI {500}{\celsius }$ ($c_0 = x_{\rm V} = 0.50$, $L = \SI {1}{\micro \metre }$). \textit {Top row} (2D, $256\times 256$ grid, $t = \SI {800}{\second }$, 80\,000 steps): (a)~finite-difference and (b)~Jansson direct composition fields $x_{\rm V}$; (c)~absolute difference map $|x^{\rm fd}_{\rm V} - x^{\rm jansson}_{\rm V}|$ ($\mathrm {RMSE} = \num {1.31e-5}$, max $= \num {2.42e-4}$); table: composition statistics and wall times (FD: \SI {279}{\second }; Jansson: \SI {199}{\second }). \textit {Bottom row} (3D, $64^3$ grid, $t = \SI {800}{\second }$, 5\,000 steps, $z = L/2$ mid-plane slice): (a)~finite-difference, (b)~Jansson, (c)~absolute difference; discrepancies remain confined to domain interfaces in both 2D and 3D, confirming method equivalence independent of dimensionality}{figure.caption.69}{}}
