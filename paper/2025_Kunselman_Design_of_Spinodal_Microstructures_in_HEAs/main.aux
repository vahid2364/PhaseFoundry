\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Comparison of the three derivative methods for the Nb-V BCC\textsubscript  {A2} system at $T = \SI {500}{\celsius  }$. Grey markers: raw CALPHAD data (60\% transparent to reveal underlying curves). (a) Molar Gibbs energy $G^\alpha _m$: all three modes are identical (shared surrogate). (b) Relative chemical potential $\mu _{\rm  Nb} - \mu _{\rm  V}$: \texttt  {fd} deviates by $\mathrm  {RMSE} = \SI {302}{\joule \per \mol }$; \texttt  {jansson} and \texttt  {hybrid} are exact. (c) Hessian $\partial ^2 G^\alpha _m/\partial x_{\rm  Nb}^2$ (clipped to $\pm \SI {150}{\kilo \joule \per \mol }$; divergence at the pure-element limits is annotated): \texttt  {fd} RMSE $= \SI {442}{\kilo \joule \per \mol }$; \texttt  {jansson} is exact. The shaded pink band marks the spinodal region ($H < 0$) identified from the \texttt  {jansson} Hessian. }}{13}{figure.caption.61}\protected@file@percent }
\newlabel{fig:deriv_methods}{{1}{13}{Comparison of the three derivative methods for the Nb-V BCC\textsubscript {A2} system at $T = \SI {500}{\celsius }$. Grey markers: raw CALPHAD data (60\% transparent to reveal underlying curves). (a) Molar Gibbs energy $G^\alpha _m$: all three modes are identical (shared surrogate). (b) Relative chemical potential $\mu _{\rm Nb} - \mu _{\rm V}$: \texttt {fd} deviates by $\mathrm {RMSE} = \SI {302}{\joule \per \mol }$; \texttt {jansson} and \texttt {hybrid} are exact. (c) Hessian $\partial ^2 G^\alpha _m/\partial x_{\rm Nb}^2$ (clipped to $\pm \SI {150}{\kilo \joule \per \mol }$; divergence at the pure-element limits is annotated): \texttt {fd} RMSE $= \SI {442}{\kilo \joule \per \mol }$; \texttt {jansson} is exact. The shaded pink band marks the spinodal region ($H < 0$) identified from the \texttt {jansson} Hessian}{figure.caption.61}{}}
\newlabel{fig:deriv_methods@cref}{{[figure][1][]1}{[1][13][]13}{}{}{}}
