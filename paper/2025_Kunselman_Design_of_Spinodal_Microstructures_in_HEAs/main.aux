\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Zener anisotropy $A_Z = C_{44}/C'$ from SQS/MLIP elastic constants for three MLIP versions along three composition paths. (a)~Binary Nb$_{50-x}$V$_{x}$: $A_Z < 1$ throughout ($\langle 110 \rangle $ favored). (b)~Ternary Nb$_{50}$Hf$_{50-x}$V$_{x}$: $A_Z$ crosses unity near $x_{\rm  V} \approx 0.11$. (c)~Quaternary Nb$_{25}$Hf$_{25}$V$_{50-x}$Ti$_{x}$: Ti drives the crossover at $x_{\rm  Ti} \approx 0.13$--$0.16$, switching modulation from $\langle 110 \rangle $ to $\langle 100 \rangle $. }}{29}{figure.caption.90}\protected@file@percent }
